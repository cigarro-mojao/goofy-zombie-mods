{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goofy Zombie independent mod registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mods"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "mods": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
